# --- База данных (PostgreSQL) -------------------------------------------
# Vercel → Storage → Create Database → Neon (Postgres) → переменная появится сама.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Доступ --------------------------------------------------------------
# Ключ администратора: нужен, чтобы менять статусы и удалять пометки (панель /inbox).
# Придумайте длинную случайную строку, например:  openssl rand -hex 24
SITEPING_API_KEY="замените-на-длинный-случайный-ключ"

# Имя проекта — должно совпадать с projectName в siteping/init.js на сайте.
SITEPING_PROJECT="ecobionika"

# Откуда разрешены запросы к API (через запятую, без слэша в конце).
SITEPING_ALLOWED_ORIGINS="https://psuhoff78-oss.github.io,http://localhost:8000"

# Публичный адрес этого сервера (для ссылок в уведомлениях). На Vercel можно не задавать.
# SITEPING_PUBLIC_URL="https://ecobionika-siteping.vercel.app"

# Адрес сайта (origin) — для ссылки «Открыть на странице» в Telegram.
SITE_BASE_URL="https://psuhoff78-oss.github.io"

# --- Уведомления (любые, по желанию) ----------------------------------
# Telegram: создайте бота у @BotFather, добавьте его в группу, узнайте chat_id
# (например, через @userinfobot или https://api.telegram.org/bot<TOKEN>/getUpdates).
# TELEGRAM_BOT_TOKEN="123456789:AAH..."
# TELEGRAM_CHAT_ID="-1001234567890"

# Slack: Incoming Webhook URL
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Discord: Webhook URL канала
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
